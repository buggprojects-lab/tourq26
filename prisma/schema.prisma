// Torq Studio — Prisma + MongoDB Atlas
// Set DATABASE_URL=mongodb+srv://.../YOUR_DB_NAME?retryWrites=true&w=majority
// Push schema: npx prisma db push   |   Seed CMS data: npm run db:seed:cms

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Torq Studio CMS (marketing site) � MongoDB collections
// =============================================================================

// Enums
// ─────────────────────────────────────────────

enum PageType {
  HOME
  SERVICE
  SOLUTION
  INDUSTRY
  TECHNOLOGY
  PRICING
  CASE_STUDY
  BLOG
  GUIDE
  COMPARISON
  GLOSSARY
  WHITEPAPER
  TEMPLATE
  RESEARCH
  NEWS
  COMPANY
  CONTACT
  LANDING
  PROGRAMMATIC
  CUSTOM
}

enum PageOrigin {
  MANUAL
  PROGRAMMATIC
}

enum WorkflowStatus {
  DRAFT
  SEO_REVIEW
  ENGINEERING_REVIEW
  EDITORIAL_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum EntityKind {
  SERVICE
  SOLUTION
  INDUSTRY
  TECHNOLOGY
  AUTHOR
  CLIENT
  CATEGORY
  TAG
  PRICING_PLAN
  FAQ
  GLOSSARY_TERM
}

enum RelationType {
  PARENT_OF
  CHILD_OF
  RELATED_TO
  USES_TECH
  SERVES_INDUSTRY
  DELIVERS_SOLUTION
  PRICED_AS
  COMPARES
  MENTIONS
  AUTHORED_BY
}

enum LinkSlot {
  RELATED_SERVICES
  RELATED_SOLUTIONS
  RELATED_TECHNOLOGIES
  RELATED_INDUSTRIES
  RELATED_PRICING
  RELATED_BLOGS
  RELATED_CASE_STUDIES
  RELATED_COMPARISONS
  RELATED_FAQS
  RELATED_GUIDES
  RELATED_GLOSSARY
}

enum AdminRoleKey {
  SUPER_ADMIN
  SEO_MANAGER
  CONTENT_STRATEGIST
  CONTENT_WRITER
  EDITOR
  DEVELOPER
  REVIEWER
  SALES
}

enum RedirectType {
  PERMANENT_301
  TEMPORARY_302
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum ProgrammaticAxis {
  TECHNOLOGY_INDUSTRY
  SERVICE_INDUSTRY
  SERVICE_TECHNOLOGY
  TECHNOLOGY_SOLUTION
  PRICING_TECHNOLOGY
  COMPARISON
  LOCATION
  CUSTOM
}

enum BuyerStage {
  AWARENESS
  CONSIDERATION
  DECISION
  RETENTION
}

enum SearchIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

// ─────────────────────────────────────────────
// Admin RBAC
// ─────────────────────────────────────────────

model CmsUser {
  id           String       @id @default(cuid()) @map("_id")
  email        String       @unique
  name         String?
  passwordHash String?
  roleKey      AdminRoleKey @default(CONTENT_WRITER)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transitions   WorkflowEvent[]
  leadsAssigned Lead[]          @relation("LeadAssignee")
}

model RolePermission {
  id         String       @id @default(cuid()) @map("_id")
  roleKey    AdminRoleKey
  permission String
  allowed    Boolean      @default(true)

  @@unique([roleKey, permission])
}

// ─────────────────────────────────────────────
// Taxonomy
// ─────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pageLinks PageCategory[]
}

model Tag {
  id        String   @id @default(cuid()) @map("_id")
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  pageLinks PageTag[]
}

model PageCategory {
  id         String   @id @default(cuid()) @map("_id")
  pageId     String
  categoryId String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([pageId, categoryId])
}

model PageTag {
  id     String @id @default(cuid()) @map("_id")
  pageId String
  tagId  String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([pageId, tagId])
}

// ─────────────────────────────────────────────
// Core Page + SEO + Brief + Blocks
// ─────────────────────────────────────────────

model Page {
  id                String         @id @default(cuid()) @map("_id")
  slug              String
  path              String         @unique
  title             String
  type              PageType
  origin            PageOrigin     @default(MANUAL)
  status            WorkflowStatus @default(DRAFT)
  locale            String         @default("en")
  excerpt           String?
  featuredMediaId   String?
  primaryEntityKind EntityKind?
  primaryEntityId   String?
  templateId        String?
  parentPageId      String?
  sortOrder         Int            @default(0)
  readingTimeMin    Int?
  contentScore      Int?
  revalidateSeconds Int            @default(3600)
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  /// Ordered block instances — validated against BlockType.schemaJson via Zod in app layer
  blocks Json @default("[]")

  /// Manual related overrides: { [LinkSlot]: string[] pageIds, lockSlots?: string[] }
  relatedOverrides Json?

  seo            SeoMetadata?
  brief          ContentBrief?
  versions       PageVersion[]
  categoryLinks  PageCategory[]
  tagLinks       PageTag[]
  entityLinks    PageEntity[]
  linkEdgesOut   InternalLinkEdge[]    @relation("LinkSource")
  linkEdgesIn    InternalLinkEdge[]    @relation("LinkTarget")
  workflowEvents WorkflowEvent[]
  template       ProgrammaticTemplate? @relation(fields: [templateId], references: [id])

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([origin, templateId])
  @@index([primaryEntityKind, primaryEntityId])
  @@index([locale, status])
}

model SeoMetadata {
  id                 String   @id @default(cuid()) @map("_id")
  pageId             String   @unique
  metaTitle          String?
  metaDescription    String?
  canonical          String?
  robotsIndex        Boolean  @default(true)
  robotsFollow       Boolean  @default(true)
  ogTitle            String?
  ogDescription      String?
  ogImageId          String?
  ogType             String   @default("website")
  twitterCard        String   @default("summary_large_image")
  twitterTitle       String?
  twitterDescription String?
  twitterImageId     String?
  /// Selected schema template keys e.g. ["Service","FAQPage"]
  schemaKeys         String[] @default([])
  /// Optional raw JSON-LD array merged after auto builders
  jsonLdCustom       Json?
  breadcrumbLabel    String?
  focusKeyword       String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ContentBrief {
  id                     String        @id @default(cuid()) @map("_id")
  pageId                 String        @unique
  targetKeyword          String?
  secondaryKeywords      String[]      @default([])
  searchIntent           SearchIntent?
  targetAudience         String?
  buyerStage             BuyerStage?
  competitorUrls         String[]      @default([])
  entityList             String[]      @default([])
  questions              String[]      @default([])
  faqs                   Json?
  suggestedInternalLinks String[]      @default([])
  suggestedExternalLinks String[]      @default([])
  contentScore           Int?
  notes                  String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageVersion {
  id          String         @id @default(cuid()) @map("_id")
  pageId      String
  version     Int
  snapshot    Json
  status      WorkflowStatus
  createdById String?
  note        String?
  createdAt   DateTime       @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model BlockType {
  id           String   @id @default(cuid()) @map("_id")
  typeKey      String   @unique
  label        String
  category     String
  /// Zod-compatible JSON Schema for props
  schemaJson   Json
  defaultProps Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model WorkflowEvent {
  id         String         @id @default(cuid()) @map("_id")
  pageId     String
  fromStatus WorkflowStatus
  toStatus   WorkflowStatus
  actorId    String?
  comment    String?
  createdAt  DateTime       @default(now())

  page  Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  actor CmsUser? @relation(fields: [actorId], references: [id])

  @@index([pageId, createdAt])
  @@index([toStatus, createdAt])
}

// ─────────────────────────────────────────────
// Entities (normalized + polymorphic links)
// ─────────────────────────────────────────────

// Service/Solution/Industry/Technology are a deliberately unified taxonomy shape — same fields,
// same optional category/parentId, so admin CMS forms and CmsEntityPage/makeHubPage can treat all
// four generically. Keep new fields added to one of these mirrored across all four.
model Service {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([parentId])
}

model Solution {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([parentId])
}

model Industry {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([parentId])
}

model Technology {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([parentId])
}

model EntityRelation {
  id           String       @id @default(cuid()) @map("_id")
  fromKind     EntityKind
  fromId       String
  toKind       EntityKind
  toId         String
  relationType RelationType @default(RELATED_TO)
  weight       Float        @default(1)
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@unique([fromKind, fromId, toKind, toId, relationType])
  @@index([fromKind, fromId])
  @@index([toKind, toId])
}

model PageEntity {
  id         String     @id @default(cuid()) @map("_id")
  pageId     String
  entityKind EntityKind
  entityId   String
  isPrimary  Boolean    @default(false)
  page       Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, entityKind, entityId])
  @@index([entityKind, entityId])
}

// ─────────────────────────────────────────────
// Authors / Clients / Testimonials / Case Studies
// ─────────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid()) @map("_id")
  quote     String
  result    String?
  name      String
  role      String?
  company   String?
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────
// Pricing / FAQ / Comparison helpers
// ─────────────────────────────────────────────

model PricingPlan {
  id         String   @id @default(cuid()) @map("_id")
  slug       String   @unique
  name       String
  summary    String?
  priceLabel String?
  currency   String?
  features   Json?
  ctaLabel   String?
  ctaHref    String?
  pageId     String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Faq {
  id         String      @id @default(cuid()) @map("_id")
  question   String
  answer     String
  entityKind EntityKind?
  entityId   String?
  pageId     String?
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([entityKind, entityId])
}

// ─────────────────────────────────────────────
// Media / Navigation / Redirects / Forms
// ─────────────────────────────────────────────

model MediaAsset {
  id          String    @id @default(cuid()) @map("_id")
  kind        MediaKind @default(IMAGE)
  url         String
  cdnKey      String?
  filename    String
  mimeType    String?
  width       Int?
  height      Int?
  sizeBytes   Int?
  alt         String?
  title       String?
  blurDataUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind, createdAt])
}

model Navigation {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  label     String
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]
}

model MenuItem {
  id           String  @id @default(cuid()) @map("_id")
  navigationId String
  parentId     String?
  label        String
  href         String?
  pageId       String?
  sortOrder    Int     @default(0)
  openInNewTab Boolean @default(false)
  metadata     Json?

  navigation Navigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)

  @@index([navigationId, sortOrder])
}

model Footer {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique @default("default")
  blurb     String?
  tagline   String?
  columns   Json
  legal     Json?
  socials   Json?
  updatedAt DateTime @updatedAt
}

model Redirect {
  id        String       @id @default(cuid()) @map("_id")
  fromPath  String       @unique
  toPath    String
  type      RedirectType @default(PERMANENT_301)
  isActive  Boolean      @default(true)
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Form {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  fields      Json
  successMsg  String?
  notifyEmail String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]
}

model Lead {
  id         String      @id @default(cuid()) @map("_id")
  formId     String
  payload    Json
  pagePath   String?
  entityKind EntityKind?
  entityId   String?
  source     String?
  status     String      @default("new")
  assigneeId String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  form     Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  assignee CmsUser? @relation("LeadAssignee", fields: [assigneeId], references: [id])

  @@index([createdAt])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────
// Internal linking + Programmatic SEO
// ─────────────────────────────────────────────

model InternalLinkEdge {
  id           String   @id @default(cuid()) @map("_id")
  sourcePageId String
  targetPageId String
  slot         LinkSlot
  score        Float    @default(0)
  isOverride   Boolean  @default(false)
  isLocked     Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  source Page @relation("LinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  target Page @relation("LinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@unique([sourcePageId, targetPageId, slot])
  @@index([sourcePageId, slot, score])
}

model SchemaTemplate {
  id          String   @id @default(cuid()) @map("_id")
  key         String   @unique
  label       String
  description String?
  /// JSON-LD template with {{mustache}} placeholders
  template    Json
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model ProgrammaticTemplate {
  id               String           @id @default(cuid()) @map("_id")
  key              String           @unique
  name             String
  axis             ProgrammaticAxis
  pathPattern      String
  titlePattern     String
  metaTitlePattern String?
  metaDescPattern  String?
  blockBlueprint   Json
  schemaKeys       String[]         @default([])
  minContentScore  Int              @default(60)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  pages Page[]
  jobs  ProgrammaticJob[]
}

model ProgrammaticJob {
  id           String    @id @default(cuid()) @map("_id")
  templateId   String
  status       String    @default("queued")
  config       Json
  total        Int       @default(0)
  createdCount Int       @default(0)
  skippedCount Int       @default(0)
  errorCount   Int       @default(0)
  log          Json?
  createdAt    DateTime  @default(now())
  finishedAt   DateTime?

  template ProgrammaticTemplate @relation(fields: [templateId], references: [id])

  @@index([status, createdAt])
}

model SiteSettings {
  id                 String   @id @default(cuid()) @map("_id")
  key                String   @unique @default("default")
  siteUrl            String?
  siteName           String   @default("Torq Studio")
  defaultTitle       String?
  defaultDescription String?
  titleTemplate      String?
  keywords           String[] @default([])
  ogTitle            String?
  ogDescription      String?
  twitterHandle      String?
  twitterTitle       String?
  twitterDescription String?
  socialProfiles     String[] @default([])
  defaultOgImageId   String?
  organizationJson   Json?
  llmsTxtExtra       String?
  featureFlags       Json?
  googleSiteVerification String?
  bingSiteVerification   String?
  robotsNoIndex          Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model BlogPost {
  id           String   @id @default(cuid()) @map("_id")
  slug         String   @unique
  title        String
  seoTitle     String?
  description  String
  excerpt      String?
  date         String
  dateUpdated  String?
  readTime     String
  body         String
  authorName   String?
  status       String   @default("published")
  coverImage   String?
  tags         String[] @default([])
  focusKeyword String?
  wordCount    Int?
}

model ContactSubmission {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
}

model CaseStudyPost {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  title       String
  seoTitle    String?
  client      String
  industry    String
  challenge   String
  outcome     String
  metric      String
  metricLabel String
  icon        String?
  coverImage  String
  coverAlt    String
  description String
  date        String
  readTime    String
  services    String[] @default([])
  body        String
  sortOrder   Int      @default(0)
}

model HomePageContent {
  id  String @id @default(cuid()) @map("_id")
  key String @unique @default("default")

  heroEyebrow           String?
  heroHeading           String?
  heroSubheading        String?
  heroPrimaryCtaLabel   String?
  heroPrimaryCtaHref    String?
  heroSecondaryCtaLabel String?
  heroSecondaryCtaHref  String?
  heroTertiaryCtaLabel  String?
  heroTertiaryCtaHref   String?
  heroTags              String[] @default([])

  heroImageEnabled Boolean @default(false)
  heroImageUrl     String?
  heroImageAlt     String?

  sliderEnabled Boolean @default(false)
  sliderHeading String?
  /// Array of { imageUrl, alt, heading, caption, ctaLabel, ctaHref }
  sliderItems   Json?

  offerBannerEnabled  Boolean @default(false)
  offerBannerText     String?
  offerBannerCtaLabel String?
  offerBannerCtaHref  String?

  offersEnabled Boolean @default(false)
  offersHeading String?
  offersIntro   String?
  /// Array of { title, description, badge, ctaLabel, ctaHref }
  offersItems   Json?

  servicesEyebrow String?
  servicesHeading String?
  servicesIntro   String?
  /// Array of { slug, title, description, result, category, icon }
  servicesItems   Json?

  whyUsEyebrow String?
  whyUsHeading String?
  whyUsIntro   String?
  /// Array of { eyebrow, stat, title, description }
  whyUsItems   Json?

  caseStudiesEyebrow String?
  caseStudiesHeading String?
  caseStudiesIntro   String?

  ctaEyebrow        String?
  ctaHeading        String?
  ctaBody           String?
  ctaPrimaryLabel   String?
  ctaPrimaryHref    String?
  ctaSecondaryLabel String?
  ctaSecondaryHref  String?
  ctaEmail          String?
  ctaFootnote       String?

  snapshotHeading    String?
  snapshotParagraphs String[] @default([])

  updatedAt DateTime @updatedAt
}

model BrandSettings {
  id               String   @id @default(cuid()) @map("_id")
  key              String   @unique @default("default")
  logoUrl          String?
  logoDarkUrl      String?
  faviconUrl       String?
  colorPrimary     String?
  colorAccent      String?
  fontHeading      String?
  fontBody         String?
  voiceDescription String?
  voiceGuidelines  String?
  updatedAt        DateTime @updatedAt
}

model ActivityLogEntry {
  id         String   @id @default(cuid()) @map("_id")
  entityType String
  entityId   String?
  action     String
  summary    String
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────
// RAG chatbot knowledge base
// ─────────────────────────────────────────────

// One row per embedded chunk of site content. Populated by `scripts/rag/build-knowledge-base.ts`.
// Retrieval uses a MongoDB Atlas Vector Search index on `embedding` — see `scripts/rag/create-vector-index.ts`.
model KnowledgeChunk {
  id         String   @id @default(cuid()) @map("_id")
  sourceType String
  sourceId   String
  chunkIndex Int      @default(0)
  title      String
  content    String
  url        String?
  embedding  Float[]
  updatedAt  DateTime @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, sourceId])
}
