// TorqStudio Interview Hub — Prisma + MongoDB Atlas
// Set DATABASE_URL=mongodb+srv://.../YOUR_DB_NAME?retryWrites=true&w=majority
// Push schema: npx prisma db push   |   Seed: npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum QuestionType {
  DSA
  UI
  QUIZ
  FRONTEND_SYSTEM_DESIGN
}

model User {
  id                   String    @id @default(cuid()) @map("_id")
  name                 String?
  email                String?   @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 String    @default("candidate")
  subscriptionTier     String    @default("free")
  monthlyQuestionViews Int       @default(0)
  monthResetAt         DateTime?
  studentVerified      Boolean   @default(false)
  solvedCount          Int       @default(0)
  totalScoreSum        Float     @default(0)
  scoreSamples         Int       @default(0)
  streakDays           Int       @default(0)
  lastActiveDate       DateTime?

  accounts        Account[]
  sessions        Session[]
  progress        UserProgress[]
  planEnrollments UserPlanEnrollment[]
  talentPool      TalentPoolEntry?
  mockBookings    MockInterviewBooking[]
  forumPosts      ForumPost[]
  jobPostings     JobPosting[]             @relation("PostedJobs")
}

model Account {
  id                String @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// MongoDB requires an explicit @id; NextAuth still uses @@unique([identifier, token]).
model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model CompanyTag {
  id       String @id @default(cuid()) @map("_id")
  name     String @unique
  category String

  questionLinks QuestionCompanyTag[]
}

// Explicit join — MongoDB does not support implicit many-to-many in Prisma.
model QuestionCompanyTag {
  id             String @id @default(cuid()) @map("_id")
  questionId     String
  companyTagId   String

  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  companyTag CompanyTag @relation(fields: [companyTagId], references: [id], onDelete: Cascade)

  @@unique([questionId, companyTagId])
}

model Question {
  id               String       @id @default(cuid()) @map("_id")
  type             QuestionType
  title            String
  description      String
  difficulty       String
  topic            String
  framework        String?
  defaultLanguage  String?
  starterCode      String?
  tests            String?
  officialSolution String?
  systemDesignMeta String?
  createdAt        DateTime     @default(now())

  companyTagLinks QuestionCompanyTag[]
  progress        UserProgress[]
  forumThreads    ForumThread[]
}

model UserProgress {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  questionId String
  solved     Boolean  @default(false)
  score      Float?
  attempts   Int      @default(0)
  lastCode   String?
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model PreparationPlan {
  id           String @id @default(cuid()) @map("_id")
  slug         String @unique
  name         String
  description  String
  durationDays Int
  milestones   String
  sortOrder    Int    @default(0)

  enrollments UserPlanEnrollment[]
}

model UserPlanEnrollment {
  id             String   @id @default(cuid()) @map("_id")
  userId         String
  planId         String
  startedAt      DateTime @default(now())
  milestonesDone Int      @default(0)

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan PreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
}

model JobPosting {
  id          String   @id @default(cuid()) @map("_id")
  companyName String
  title       String
  description String
  location    String
  skills      String
  postedById  String?
  createdAt   DateTime @default(now())

  postedBy User? @relation("PostedJobs", fields: [postedById], references: [id])
}

model TalentPoolEntry {
  id         String   @id @default(cuid()) @map("_id")
  userId     String   @unique
  optIn      Boolean  @default(false)
  avgScore   Float    @default(0)
  percentile Float?
  skills     String
  location   String?
  headline   String?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MockInterviewBooking {
  id               String    @id @default(cuid()) @map("_id")
  userId           String
  stripeSessionId  String?
  scheduledAt      DateTime?
  calendlyEventUrl String?
  status           String    @default("pending")
  amountInr        Int       @default(2499)
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForumThread {
  id         String   @id @default(cuid()) @map("_id")
  questionId String
  title      String
  createdAt  DateTime @default(now())

  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  posts    ForumPost[]
}

model ForumPost {
  id        String   @id @default(cuid()) @map("_id")
  threadId  String
  userId    String
  body      String
  createdAt DateTime @default(now())

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Interview Q&A banks (admin-managed; e.g. Node.js, React — seed fills `nodejs` from static file) ---

model InterviewQuestionBank {
  id          String @id @default(cuid()) @map("_id")
  slug        String @unique
  label       String
  description String?
  sortOrder   Int    @default(0)

  categories InterviewBankCategory[]
  items      InterviewBankItem[]
}

model InterviewBankCategory {
  id        String @id @default(cuid()) @map("_id")
  bankId    String
  bank      InterviewQuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  slug      String
  label     String
  sortOrder Int    @default(0)

  items InterviewBankItem[]

  @@unique([bankId, slug])
}

model InterviewBankItem {
  id            String @id @default(cuid()) @map("_id")
  bankId        String
  bank          InterviewQuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  /** Stable URL segment within this bank (legacy numeric ids preserved for `nodejs` seed) */
  publicId      String
  categoryId    String
  category      InterviewBankCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  question      String
  answer        String
  difficulty    String?
  categoryBadge String?
  answerIntro   String?
  bulletsJson   String?
  codeExample   String?
  sourceName    String?
  sourceUrl     String?
  sortOrder     Int    @default(0)

  @@unique([bankId, publicId])
}


// =============================================================================
// Torq Studio CMS (marketing site) � MongoDB collections
// =============================================================================

// Enums
// ─────────────────────────────────────────────

enum PageType {
  HOME
  SERVICE
  SOLUTION
  INDUSTRY
  TECHNOLOGY
  PRICING
  CASE_STUDY
  BLOG
  GUIDE
  COMPARISON
  GLOSSARY
  WHITEPAPER
  TEMPLATE
  RESEARCH
  NEWS
  COMPANY
  CONTACT
  LANDING
  PROGRAMMATIC
  CUSTOM
}

enum PageOrigin {
  MANUAL
  PROGRAMMATIC
}

enum WorkflowStatus {
  DRAFT
  SEO_REVIEW
  ENGINEERING_REVIEW
  EDITORIAL_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum EntityKind {
  SERVICE
  SOLUTION
  INDUSTRY
  TECHNOLOGY
  AUTHOR
  CLIENT
  CATEGORY
  TAG
  PRICING_PLAN
  FAQ
  GLOSSARY_TERM
}

enum RelationType {
  PARENT_OF
  CHILD_OF
  RELATED_TO
  USES_TECH
  SERVES_INDUSTRY
  DELIVERS_SOLUTION
  PRICED_AS
  COMPARES
  MENTIONS
  AUTHORED_BY
}

enum LinkSlot {
  RELATED_SERVICES
  RELATED_SOLUTIONS
  RELATED_TECHNOLOGIES
  RELATED_INDUSTRIES
  RELATED_PRICING
  RELATED_BLOGS
  RELATED_CASE_STUDIES
  RELATED_COMPARISONS
  RELATED_FAQS
  RELATED_GUIDES
  RELATED_GLOSSARY
}

enum AdminRoleKey {
  SUPER_ADMIN
  SEO_MANAGER
  CONTENT_STRATEGIST
  CONTENT_WRITER
  EDITOR
  DEVELOPER
  REVIEWER
  SALES
}

enum RedirectType {
  PERMANENT_301
  TEMPORARY_302
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
  AUDIO
  OTHER
}

enum ProgrammaticAxis {
  TECHNOLOGY_INDUSTRY
  SERVICE_INDUSTRY
  SERVICE_TECHNOLOGY
  TECHNOLOGY_SOLUTION
  PRICING_TECHNOLOGY
  COMPARISON
  LOCATION
  CUSTOM
}

enum BuyerStage {
  AWARENESS
  CONSIDERATION
  DECISION
  RETENTION
}

enum SearchIntent {
  INFORMATIONAL
  NAVIGATIONAL
  COMMERCIAL
  TRANSACTIONAL
}

// ─────────────────────────────────────────────
// Admin RBAC
// ─────────────────────────────────────────────

model CmsUser {
  id           String       @id @default(cuid()) @map("_id")
  email        String       @unique
  name         String?
  passwordHash String?
  roleKey      AdminRoleKey @default(CONTENT_WRITER)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transitions WorkflowEvent[]
  leadsAssigned Lead[] @relation("LeadAssignee")
}

model RolePermission {
  id         String       @id @default(cuid()) @map("_id")
  roleKey    AdminRoleKey
  permission String
  allowed    Boolean      @default(true)

  @@unique([roleKey, permission])
}

// ─────────────────────────────────────────────
// Taxonomy
// ─────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pageLinks PageCategory[]
}

model Tag {
  id        String   @id @default(cuid()) @map("_id")
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  pageLinks PageTag[]
}

model PageCategory {
  id         String @id @default(cuid()) @map("_id")
  pageId     String
  categoryId String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([pageId, categoryId])
}

model PageTag {
  id     String @id @default(cuid()) @map("_id")
  pageId String
  tagId  String
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([pageId, tagId])
}

// ─────────────────────────────────────────────
// Core Page + SEO + Brief + Blocks
// ─────────────────────────────────────────────

model Page {
  id                String         @id @default(cuid()) @map("_id")
  slug              String
  path              String         @unique
  title             String
  type              PageType
  origin            PageOrigin     @default(MANUAL)
  status            WorkflowStatus @default(DRAFT)
  locale            String         @default("en")
  excerpt           String?
  featuredMediaId   String?
  primaryEntityKind EntityKind?
  primaryEntityId   String?
  templateId        String?
  parentPageId      String?
  sortOrder         Int            @default(0)
  readingTimeMin    Int?
  contentScore      Int?
  revalidateSeconds Int            @default(3600)
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  /// Ordered block instances — validated against BlockType.schemaJson via Zod in app layer
  blocks Json @default("[]")

  /// Manual related overrides: { [LinkSlot]: string[] pageIds, lockSlots?: string[] }
  relatedOverrides Json?

  seo           SeoMetadata?
  brief         ContentBrief?
  versions      PageVersion[]
  categoryLinks PageCategory[]
  tagLinks      PageTag[]
  entityLinks   PageEntity[]
  linkEdgesOut  InternalLinkEdge[] @relation("LinkSource")
  linkEdgesIn   InternalLinkEdge[] @relation("LinkTarget")
  workflowEvents WorkflowEvent[]
  caseStudy     CaseStudy?
  blogMeta      BlogMeta?
  template      ProgrammaticTemplate? @relation(fields: [templateId], references: [id])

  @@index([status, publishedAt])
  @@index([type, status])
  @@index([origin, templateId])
  @@index([primaryEntityKind, primaryEntityId])
  @@index([locale, status])
}

model SeoMetadata {
  id              String  @id @default(cuid()) @map("_id")
  pageId          String  @unique
  metaTitle       String?
  metaDescription String?
  canonical       String?
  robotsIndex     Boolean @default(true)
  robotsFollow    Boolean @default(true)
  ogTitle         String?
  ogDescription   String?
  ogImageId       String?
  ogType          String  @default("website")
  twitterCard     String  @default("summary_large_image")
  twitterTitle    String?
  twitterDescription String?
  twitterImageId  String?
  /// Selected schema template keys e.g. ["Service","FAQPage"]
  schemaKeys      String[] @default([])
  /// Optional raw JSON-LD array merged after auto builders
  jsonLdCustom    Json?
  breadcrumbLabel String?
  focusKeyword    String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model ContentBrief {
  id                    String        @id @default(cuid()) @map("_id")
  pageId                String        @unique
  targetKeyword         String?
  secondaryKeywords     String[]      @default([])
  searchIntent          SearchIntent?
  targetAudience        String?
  buyerStage            BuyerStage?
  competitorUrls        String[]      @default([])
  entityList            String[]      @default([])
  questions             String[]      @default([])
  faqs                  Json?
  suggestedInternalLinks String[]     @default([])
  suggestedExternalLinks String[]     @default([])
  contentScore          Int?
  notes                 String?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

model PageVersion {
  id          String         @id @default(cuid()) @map("_id")
  pageId      String
  version     Int
  snapshot    Json
  status      WorkflowStatus
  createdById String?
  note        String?
  createdAt   DateTime       @default(now())

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, version])
  @@index([pageId, createdAt])
}

model BlockType {
  id          String   @id @default(cuid()) @map("_id")
  typeKey     String   @unique
  label       String
  category    String
  /// Zod-compatible JSON Schema for props
  schemaJson  Json
  defaultProps Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkflowEvent {
  id          String         @id @default(cuid()) @map("_id")
  pageId      String
  fromStatus  WorkflowStatus
  toStatus    WorkflowStatus
  actorId     String?
  comment     String?
  createdAt   DateTime       @default(now())

  page  Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  actor CmsUser? @relation(fields: [actorId], references: [id])

  @@index([pageId, createdAt])
  @@index([toStatus, createdAt])
}

// ─────────────────────────────────────────────
// Entities (normalized + polymorphic links)
// ─────────────────────────────────────────────

model Service {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  parentId    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
}

model Solution {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Industry {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Technology {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  description String?
  icon        String?
  category    String?
  sortOrder   Int      @default(0)
  pageId      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model EntityRelation {
  id           String       @id @default(cuid()) @map("_id")
  fromKind     EntityKind
  fromId       String
  toKind       EntityKind
  toId         String
  relationType RelationType @default(RELATED_TO)
  weight       Float        @default(1)
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@unique([fromKind, fromId, toKind, toId, relationType])
  @@index([fromKind, fromId])
  @@index([toKind, toId])
}

model PageEntity {
  id         String     @id @default(cuid()) @map("_id")
  pageId     String
  entityKind EntityKind
  entityId   String
  isPrimary  Boolean    @default(false)
  page       Page       @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, entityKind, entityId])
  @@index([entityKind, entityId])
}

// ─────────────────────────────────────────────
// Authors / Clients / Testimonials / Case Studies
// ─────────────────────────────────────────────

model Author {
  id        String   @id @default(cuid()) @map("_id")
  slug      String   @unique
  name      String
  title     String?
  bio       String?
  avatarId  String?
  sameAs    String[] @default([])
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blogMetas BlogMeta[]
}

model Client {
  id        String   @id @default(cuid()) @map("_id")
  slug      String   @unique
  name      String
  logoId    String?
  website   String?
  industry  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  caseStudies  CaseStudy[]
}

model Testimonial {
  id        String   @id @default(cuid()) @map("_id")
  quote     String
  result    String?
  name      String
  role      String?
  company   String?
  rating    Int      @default(5)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model CaseStudy {
  id             String   @id @default(cuid()) @map("_id")
  pageId         String   @unique
  clientId       String?
  problem        String?
  solution       String?
  architecture   String?
  timeline       String?
  businessResult String?
  clientIndustry String?
  team           Json?
  technologies   String[] @default([])
  screenshots    String[] @default([])
  downloadIds    String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id])
}

model BlogMeta {
  id           String   @id @default(cuid()) @map("_id")
  pageId       String   @unique
  authorId     String?
  series       String?
  toc          Json?
  aiSummary    String?
  keyTakeaways String[] @default([])
  newsletterCta Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author Author? @relation(fields: [authorId], references: [id])
}

// ─────────────────────────────────────────────
// Pricing / FAQ / Comparison helpers
// ─────────────────────────────────────────────

model PricingPlan {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  summary     String?
  priceLabel  String?
  currency    String?
  features    Json?
  ctaLabel    String?
  ctaHref     String?
  pageId      String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id         String   @id @default(cuid()) @map("_id")
  question   String
  answer     String
  entityKind EntityKind?
  entityId   String?
  pageId     String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityKind, entityId])
}

// ─────────────────────────────────────────────
// Media / Navigation / Redirects / Forms
// ─────────────────────────────────────────────

model MediaAsset {
  id          String    @id @default(cuid()) @map("_id")
  kind        MediaKind @default(IMAGE)
  url         String
  cdnKey      String?
  filename    String
  mimeType    String?
  width       Int?
  height      Int?
  sizeBytes   Int?
  alt         String?
  title       String?
  blurDataUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([kind, createdAt])
}

model Navigation {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  label     String
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MenuItem[]
}

model MenuItem {
  id           String  @id @default(cuid()) @map("_id")
  navigationId String
  parentId     String?
  label        String
  href         String?
  pageId       String?
  sortOrder    Int     @default(0)
  openInNewTab Boolean @default(false)
  metadata     Json?

  navigation Navigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)

  @@index([navigationId, sortOrder])
}

model Footer {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique @default("default")
  blurb     String?
  tagline   String?
  columns   Json
  legal     Json?
  socials   Json?
  updatedAt DateTime @updatedAt
}

model Redirect {
  id        String       @id @default(cuid()) @map("_id")
  fromPath  String       @unique
  toPath    String
  type      RedirectType @default(PERMANENT_301)
  isActive  Boolean      @default(true)
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Form {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  name        String
  fields      Json
  successMsg  String?
  notifyEmail String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads Lead[]
}

model Lead {
  id           String   @id @default(cuid()) @map("_id")
  formId       String
  payload      Json
  pagePath     String?
  entityKind   EntityKind?
  entityId     String?
  source       String?
  status       String   @default("new")
  assigneeId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  form     Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  assignee CmsUser? @relation("LeadAssignee", fields: [assigneeId], references: [id])

  @@index([createdAt])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────
// Internal linking + Programmatic SEO
// ─────────────────────────────────────────────

model InternalLinkEdge {
  id           String   @id @default(cuid()) @map("_id")
  sourcePageId String
  targetPageId String
  slot         LinkSlot
  score        Float    @default(0)
  isOverride   Boolean  @default(false)
  isLocked     Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  source Page @relation("LinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  target Page @relation("LinkTarget", fields: [targetPageId], references: [id], onDelete: Cascade)

  @@unique([sourcePageId, targetPageId, slot])
  @@index([sourcePageId, slot, score])
}

model SchemaTemplate {
  id          String   @id @default(cuid()) @map("_id")
  key         String   @unique
  label       String
  description String?
  /// JSON-LD template with {{mustache}} placeholders
  template    Json
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model ProgrammaticTemplate {
  id              String           @id @default(cuid()) @map("_id")
  key             String           @unique
  name            String
  axis            ProgrammaticAxis
  pathPattern     String
  titlePattern    String
  metaTitlePattern String?
  metaDescPattern String?
  blockBlueprint  Json
  schemaKeys      String[]         @default([])
  minContentScore Int              @default(60)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  pages Page[]
  jobs  ProgrammaticJob[]
}

model ProgrammaticJob {
  id           String   @id @default(cuid()) @map("_id")
  templateId   String
  status       String   @default("queued")
  config       Json
  total        Int      @default(0)
  createdCount Int      @default(0)
  skippedCount Int      @default(0)
  errorCount   Int      @default(0)
  log          Json?
  createdAt    DateTime @default(now())
  finishedAt   DateTime?

  template ProgrammaticTemplate @relation(fields: [templateId], references: [id])

  @@index([status, createdAt])
}

model SiteSettings {
  id                 String   @id @default(cuid()) @map("_id")
  key                String   @unique @default("default")
  siteUrl            String?
  siteName           String   @default("Torq Studio")
  defaultTitle       String?
  defaultDescription String?
  titleTemplate      String?
  keywords           String[] @default([])
  ogTitle            String?
  ogDescription      String?
  twitterHandle      String?
  twitterTitle       String?
  twitterDescription String?
  socialProfiles     String[] @default([])
  defaultOgImageId   String?
  organizationJson   Json?
  llmsTxtExtra       String?
  featureFlags       Json?
  updatedAt          DateTime @updatedAt
}

model BlogPost {
  id           String   @id @default(cuid()) @map("_id")
  slug         String   @unique
  title        String
  seoTitle     String?
  description  String
  excerpt      String?
  date         String
  dateUpdated  String?
  readTime     String
  body         String
  authorName   String?
  status       String   @default("published")
  coverImage   String?
  tags         String[] @default([])
  focusKeyword String?
  wordCount    Int?
}

model ContactSubmission {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  email     String
  company   String?
  message   String
  createdAt DateTime @default(now())
}

model CaseStudyPost {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
  title       String
  seoTitle    String?
  client      String
  industry    String
  challenge   String
  outcome     String
  metric      String
  metricLabel String
  icon        String?
  coverImage  String
  coverAlt    String
  description String
  date        String
  readTime    String
  services    String[] @default([])
  body        String
  sortOrder   Int      @default(0)
}

model HomePageContent {
  id      String @id @default(cuid()) @map("_id")
  key     String @unique @default("default")

  heroEyebrow          String?
  heroHeading          String?
  heroSubheading       String?
  heroPrimaryCtaLabel  String?
  heroPrimaryCtaHref   String?
  heroSecondaryCtaLabel String?
  heroSecondaryCtaHref String?
  heroTertiaryCtaLabel String?
  heroTertiaryCtaHref  String?
  heroTags             String[] @default([])

  servicesEyebrow String?
  servicesHeading String?
  servicesIntro   String?
  /// Array of { slug, title, description, result, category, icon }
  servicesItems   Json?

  whyUsEyebrow String?
  whyUsHeading String?
  whyUsIntro   String?
  /// Array of { eyebrow, stat, title, description }
  whyUsItems   Json?

  caseStudiesEyebrow String?
  caseStudiesHeading String?
  caseStudiesIntro   String?

  ctaEyebrow        String?
  ctaHeading        String?
  ctaBody           String?
  ctaPrimaryLabel   String?
  ctaPrimaryHref    String?
  ctaSecondaryLabel String?
  ctaSecondaryHref  String?
  ctaEmail          String?
  ctaFootnote       String?

  snapshotHeading    String?
  snapshotParagraphs String[] @default([])

  updatedAt DateTime @updatedAt
}

model BrandSettings {
  id               String   @id @default(cuid()) @map("_id")
  key              String   @unique @default("default")
  logoUrl          String?
  logoDarkUrl      String?
  faviconUrl       String?
  colorPrimary     String?
  colorAccent      String?
  fontHeading      String?
  fontBody         String?
  voiceDescription String?
  voiceGuidelines  String?
  updatedAt        DateTime @updatedAt
}

model ActivityLogEntry {
  id         String   @id @default(cuid()) @map("_id")
  entityType String
  entityId   String?
  action     String
  summary    String
  createdAt  DateTime @default(now())
}

